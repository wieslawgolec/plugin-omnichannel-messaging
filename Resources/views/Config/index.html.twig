{% extends '@MauticCore/Default/content.html.twig' %}

{% block headerTitle %}{% trans %}mautic.omnichannel.config{% endtrans %}{% endblock %}

{% block content %}
  <div class="pa-md">
    <ul class="list-group">
      {% for channel, enabled in channels %}
        <li class="list-group-item">
          <a href="{{ path('mautic_omnichannel_config_edit', {channel: channel}) }}">
            {{ channel|capitalize }}
          </a>
          {% if enabled %}
            <span class="label label-success pull-right">enabled</span>
          {% else %}
            <span class="label label-default pull-right">disabled</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endblock %}
