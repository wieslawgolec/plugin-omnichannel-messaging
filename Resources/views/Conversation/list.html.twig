{% extends '@MauticCore/Default/content.html.twig' %}

{% block headerTitle %}{% trans %}mautic.omnichannel.conversations{% endtrans %}{% endblock %}

{% block content %}
  {% if items is empty %}
    {% include '@MauticCore/Helper/no_results.html.twig' %}
  {% else %}
    <div class="table-responsive panel-body">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>ID</th>
            <th>{% trans %}mautic.lead.lead{% endtrans %} / Contact</th>
            <th>{% trans %}mautic.omnichannel.form.channel{% endtrans %}</th>
            <th>Status</th>
            <th>Window</th>
            <th>Msgs</th>
            <th>{% trans %}mautic.core.date.updated{% endtrans %}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in items %}
            <tr>
              <td>{{ item.id }}</td>
              <td>
                <a href="{{ path('mautic_omnichannel_conversations_view', {objectId: item.id}) }}">
                  {{ item.contactIdentifier }}
                </a>
              </td>
              <td>{{ item.channel }}</td>
              <td>{{ item.status }}</td>
              <td>
                {% if item.isWindowOpen %}
                  <span class="label label-success">open</span>
                {% else %}
                  <span class="label label-default">closed</span>
                {% endif %}
              </td>
              <td>{{ item.messageCount }}</td>
              <td>{{ item.dateModified ? item.dateModified|date('Y-m-d H:i') : '—' }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
{% endblock %}
