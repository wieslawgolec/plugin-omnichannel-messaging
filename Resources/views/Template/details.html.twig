{% extends '@MauticCore/Default/content.html.twig' %}

{% block headerTitle %}{{ entity.name }}{% endblock %}

{% block content %}
  <div class="pa-md">
    <div class="row">
      <div class="col-md-6">
        <dl class="dl-horizontal">
          <dt>{% trans %}mautic.omnichannel.form.channel{% endtrans %}</dt>
          <dd>{{ entity.channel }}</dd>
          <dt>{% trans %}mautic.omnichannel.form.language{% endtrans %}</dt>
          <dd>{{ entity.language }}</dd>
          <dt>{% trans %}mautic.omnichannel.template.status{% endtrans %}</dt>
          <dd><span class="label label-default">{{ entity.status }}</span></dd>
          <dt>{% trans %}mautic.omnichannel.template.category{% endtrans %}</dt>
          <dd>{{ entity.category }}</dd>
          <dt>{% trans %}mautic.core.form.published{% endtrans %}</dt>
          <dd>{{ entity.isPublished ? 'yes' : 'no' }}</dd>
        </dl>
      </div>
      <div class="col-md-6">
        <h4>{% trans %}mautic.omnichannel.template.body{% endtrans %}</h4>
        <pre class="pa-md bg-auto">{{ entity.body }}</pre>
      </div>
    </div>
  </div>
{% endblock %}
